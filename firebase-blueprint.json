{
  "entities": {
    "employees": {
      "title": "Employee",
      "description": "Staff profiles, credentials, HR file permissions, and account settings",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "empCode": { "type": "string" },
        "firstName": { "type": "string" },
        "lastName": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string" },
        "department": { "type": "string" },
        "jobTitle": { "type": "string" },
        "status": { "type": "string" },
        "photo": { "type": "string" },
        "mustChangePassword": { "type": "boolean" },
        "filePermissionGranted": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid", "email", "role", "firstName", "lastName"]
    },
    "staff_files": {
      "title": "Staff File",
      "description": "User documents and files uploaded by staff or managed by HR",
      "type": "object",
      "properties": {
        "ownerUid": { "type": "string" },
        "ownerEmail": { "type": "string" },
        "fileName": { "type": "string" },
        "fileType": { "type": "string" },
        "fileSize": { "type": "number" },
        "fileData": { "type": "string" },
        "category": { "type": "string" },
        "description": { "type": "string" },
        "uploadedAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "permissionGrantedByHr": { "type": "boolean" }
      },
      "required": ["ownerUid", "fileName", "fileData"]
    },
    "audit_logs": {
      "title": "Audit Log",
      "description": "System security and HR audit logs",
      "type": "object",
      "properties": {
        "timestamp": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userRole": { "type": "string" },
        "action": { "type": "string" },
        "module": { "type": "string" },
        "details": { "type": "string" }
      },
      "required": ["action", "timestamp"]
    },
    "leaves": {
      "title": "Leave Request",
      "description": "4-tier leave applications and approval workflows",
      "type": "object",
      "properties": {
        "employeeId": { "type": "string" },
        "leaveType": { "type": "string" },
        "startDate": { "type": "string" },
        "endDate": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["employeeId", "leaveType", "startDate", "endDate", "status"]
    },
    "attendance": {
      "title": "Attendance Record",
      "description": "Biometric clock-ins, clock-outs, and overtime records",
      "type": "object",
      "properties": {
        "employeeId": { "type": "string" },
        "date": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["employeeId", "date", "status"]
    },
    "monthly_unit_roasters": {
      "title": "Monthly Unit Roster",
      "description": "Hospital unit shift schedules and rotations",
      "type": "object",
      "properties": {
        "department": { "type": "string" },
        "month": { "type": "string" },
        "year": { "type": "number" }
      },
      "required": ["department", "month", "year"]
    },
    "annual_unit_leave_roasters": {
      "title": "Annual Leave Roster",
      "description": "Annual unit leave planning schedules",
      "type": "object",
      "properties": {
        "department": { "type": "string" },
        "year": { "type": "number" }
      },
      "required": ["department", "year"]
    },
    "performance_appraisals": {
      "title": "Performance Appraisal",
      "description": "Annual and mid-year staff performance appraisal records",
      "type": "object",
      "properties": {
        "employeeId": { "type": "string" },
        "reviewPeriod": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["employeeId", "reviewPeriod", "status"]
    },
    "staff_queries": {
      "title": "Staff Query",
      "description": "Official HR administrative queries and staff explanations",
      "type": "object",
      "properties": {
        "employeeId": { "type": "string" },
        "subject": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["employeeId", "subject", "status"]
    },
    "disciplinary_hearings": {
      "title": "Disciplinary Hearing",
      "description": "Hospital disciplinary committee hearings and outcome records",
      "type": "object",
      "properties": {
        "employeeId": { "type": "string" },
        "hearingDate": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["employeeId", "hearingDate", "status"]
    }
  }
}
